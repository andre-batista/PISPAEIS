  ISBN = {9780470602492},
  KEYWORDS = {ant colony optimization method,genetic algorithm,particle swarm optimization method,population-based algorithms,simulated annealing technique,stochastic minimization methods},
  PAGES = {153--192},
  TITLE = {Quantitative Stochastic Reconstruction Methods},
}

